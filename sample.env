# ──────────────────────────────────────────────────────────────────────
#  BharatFarm  —  Environment Configuration
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to Git.
# ──────────────────────────────────────────────────────────────────────

# ── AI (existing) ─────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here

# ── Image APIs (existing) ──────────────────────────────────────────────
UNSPLASH_API_KEY=your_unsplash_key_here
PEXELS_API_KEY=your_pexels_key_here

# ── SMS Provider ───────────────────────────────────────────────────────
# Choose one provider below and set SMS_PROVIDER accordingly.
# Supported: fast2sms | twilio | msg91
SMS_PROVIDER=fast2sms

# ── Option 1: Fast2SMS  (Recommended for India — cheapest, DLT-compliant)
# Sign up: https://www.fast2sms.com/
# Dashboard → Dev API → Copy your API Key
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ── Option 2: Twilio  (Global — works internationally)
# Sign up: https://www.twilio.com/try-twilio
# Console → Account SID + Auth Token + Buy a phone number
# IMPORTANT: Use a Twilio number that supports SMS to India (+91)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+14155552671

# ── Option 3: MSG91  (India — popular, high deliverability)
# Sign up: https://msg91.com/
# Create an OTP template to get template_id (required by TRAI regulations)
MSG91_AUTHKEY=your_msg91_authkey_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here

# ── Server ────────────────────────────────────────────────────────────
PORT=5000
