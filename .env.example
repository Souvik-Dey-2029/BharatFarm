# BHARATFARM PRODUCTION ENV CONFIGURATION

# Deployment Port (Render or Railway will inject this automatically)
PORT=5000

# Environment Type (development / production)
NODE_ENV=production

# ── API INTEGRATION KEYS ──────────────────────────────────
# Get a key from https://openrouter.ai/ for Gemini AI queries
OPENROUTER_API_KEY=your_openrouter_api_key_here

# (Optional) For high-fidelity unsplash farming visual proxies
UNSPLASH_API_KEY=your_unsplash_api_key_here

# (Optional) For high-fidelity pexels farming visual proxies
PEXELS_API_KEY=your_pexels_api_key_here

# ── MOBILE APP ONBOARDING ────────────────────────────────
# LAN Expo URL (auto-detected at runtime if left empty)
# Format: exp://YOUR_LAN_IP:8081
# Example: exp://192.168.1.5:8081
# NOTE: The server now auto-detects LAN IP — this is only needed for manual override.
# BHARATFARM_EXPO_URL=exp://192.168.1.5:8081

# (Optional) Production APK download URL
# BHARATFARM_APK_URL=https://your-cdn.com/bharatfarm.apk
