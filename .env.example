# BHARATFARM PRODUCTION ENV CONFIGURATION

# Deployment Port (Render or Railway will inject this automatically)
PORT=5000

# Environment Type (development / production)
NODE_ENV=production

# ── API INTEGRATION KEYS ──────────────────────────────────
# Get a key from https://openrouter.ai/ for Gemini AI queries
OPENROUTER_API_KEY=your_openrouter_api_key_here

# (Optional) For high-fidelity unsplash farming visual proxies
UNSPLASH_API_KEY=your_unsplash_api_key_here

# (Optional) For high-fidelity pexels farming visual proxies
PEXELS_API_KEY=your_pexels_api_key_here
