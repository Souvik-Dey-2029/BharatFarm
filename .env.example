# BharatFarm Environment Variables
# Copy this to .env and fill in with actual values
# NEVER commit .env to version control

# OpenRouter API (for AI chat, disease detection, scheme recommendations)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API (for real-time voice sessions)
OPENAI_API_KEY=your_openai_api_key_here

# Unsplash API (for crop images)
UNSPLASH_API_KEY=your_unsplash_api_key_here

# Pexels API (alternative for crop images)
PEXELS_API_KEY=your_pexels_api_key_here

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (when implemented)
# DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/bharatfarm
# DATABASE_NAME=bharatfarm

# JWT Secret (for authentication tokens)
# JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Payment Verification (UPI)
# UPI_RECIPIENT=9339791297@ptyes
# UPI_RECIPIENT_NAME=Snehasis Chakraborty
# UPI_AMOUNT=49

# Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password_here

# Frontend Configuration
# REACT_APP_API_URL=http://localhost:5000
# REACT_APP_VERCEL_URL=https://bharatfarm.vercel.app
